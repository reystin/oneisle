{
  "schemaVersion": 1,
  "id": "oneisle",
  "version": "${version}",
  "name": "OneIsle — All Biomes & Structures on One Island",
  "description": "Build a configurable island with every Overworld biome, selectable structures, living rivers and a deep surrounding ocean. Independent continuation of OmniIsle 0.5.0 by Hack337.",
  "authors": [
    "reystin"
  ],
  "contributors": [
    "Hack337"
  ],
  "contact": {
    "homepage": "https://github.com/reystin/oneisle",
    "sources": "https://github.com/reystin/oneisle",
    "issues": "https://github.com/reystin/oneisle/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/oneisle/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "com.reystin.oneisle.OneIslePreLaunch"
    ],
    "main": [
      "com.reystin.oneisle.OneIsleMod"
    ],
    "client": [
      "com.reystin.oneisle.client.OneIsleClient"
    ]
  },
  "mixins": [
    {
      "config": "oneisle.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  }
}
